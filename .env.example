# Copy this file to .env and fill in your values.
# Never commit .env to version control.

YOUTUBE_API_KEY=             # Google Cloud Console → Credentials → API Key
ANTHROPIC_API_KEY=           # console.anthropic.com → API Keys
KLING_API_KEY=               # klingai.com → Developer → API Key
RUNWAY_API_KEY=              # app.runwayml.com → Account → API Key (fallback)
HIGGSFIELD_API_KEY=          # higgsfield.ai → Settings → API Key (fallback)
YOUTUBE_CLIENT_SECRET=       # Path to OAuth 2.0 client_secret.json file
ALERT_SMTP_HOST=             # Optional: SMTP host for failure alerts
ALERT_SMTP_USER=             # Optional: SMTP username
ALERT_SMTP_PASS=             # Optional: SMTP password
